# Copy this file to .env and fill in real local values.
# .env is git-ignored - never commit real secrets.

SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_cms
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Generate a long random string for each secret below.
# JWT_SECRET is used from Phase 1 (JWT signing) - must be at least 32
# characters (HS256 requires a 256-bit key; the app fails fast at startup
# with a clear error if this is missing or too short).
# IP_HASH_SECRET is used from Phase 9 (recruiter analytics IP hashing).
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters
JWT_EXPIRATION_MS=86400000
IP_HASH_SECRET=replace_with_a_different_long_random_secret

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

UPLOAD_DIR=./uploads
